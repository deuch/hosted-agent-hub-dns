   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A client in snet-agent or snet-vm uses 10.1.0.4 as DNS server. vnet-dns is not\npeered with vnet-ai, so the UDR sends the query to the firewall (rule: port 53).",
   "originalText": "A client in snet-agent or snet-vm uses 10.1.0.4 as DNS server. vnet-dns is not\npeered with vnet-ai, so the UDR sends the query to the firewall (rule: port 53).",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
