# yaml-language-server: $schema=https://raw.githubusercontent.com/Azure/azure-dev/main/schemas/v1.0/azure.yaml.json
# Template: deploy.ps1 replaces __AGENT_NAME__ and writes azure.yaml. ${VARIABLES} are resolved by azd from the azd environment.

infra:
    provider: microsoft.foundry
name: hosted-agent
services:
    default-project:
        endpoint: ${FOUNDRY_PROJECT_ENDPOINT}
        host: azure.ai.project
    agent:
        container:
            resources:
                cpu: "0.5"
                memory: 1Gi
        description: Hosted container agent using pre-built image ${AGENT_IMAGE}
        docker:
            imagePassthrough: true
        env:
            AZURE_AI_MODEL_DEPLOYMENT_NAME: ${MODEL_DEPLOYMENT_NAME}
            PYTHONNOUSERSITE: "1"
        host: azure.ai.agent
        image: ${AGENT_IMAGE}
        kind: hosted
        language: docker
        name: __AGENT_NAME__
        project: src/agent
        protocols:
            - protocol: responses
              version: 2.0.0
        uses:
            - default-project
